{
  "name": "breathe-time",
  "version": "1.0.0",
  "description": "Gestão de Tempo Desktop com Cronômetros e Divisões para Bitrix24",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173 --strictPort",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "tsc && vite build",
    "dist:exe": "npm run build && node scripts/build-exe.cjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
